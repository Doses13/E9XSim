<Window x:Class="E9XSim.mainApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E9XSim"
        Width="1280"
        Height="720"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <!-- Runtime toolbar -->
            <RowDefinition Height="Auto"/>

            <!-- Main workspace -->
            <RowDefinition Height="*"
                   MinHeight="150"/>

            <!-- Draggable divider -->
            <RowDefinition Height="6"/>

            <!-- Bus monitor -->
            <RowDefinition Height="180"
                   MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- Runtime Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10">

            <DockPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <Button Content="▶"
                            Width="42"
                            Height="32"
                            Click="Play_Click"/>

                    <Button Width="42"
                            Height="32"
                            Margin="5,0,0,0"
                            Click="Pause_Click">        

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Rectangle Width="4"
                                       Height="14"
                                       Fill="{StaticResource TextBrush}"/>

                            <Rectangle Width="4"
                                       Height="14"
                                       Margin="4,0,0,0"
                                       Fill="{StaticResource TextBrush}"/>

                        </StackPanel>

                    </Button>

                    <Button Content="▷"
                            Width="42"
                            Height="32"
                            Margin="5,0,0,0"
                            Click="Step_Click"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <TextBlock Text="SIM"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="20,0,8,0"/>

                    <TextBlock x:Name="SimulationTimeText"
                               Text="00:00:00.000"
                               FontFamily="Consolas"
                               FontSize="16"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="1.00x"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1"
              Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Module Shelf -->
            <Border Grid.Column="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="12">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                       Text="MODULES"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="4,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding ModuleShelf}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,8">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               FontSize="14"/>

                                            <TextBlock Text="{Binding Type}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                        Content="Open"
                                        Padding="12,4"
                                        Margin="10,0,0,0"
                                        Tag="{Binding}"
                                        Click="OpenModule_Click"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </DockPanel>

            </Border>

            <!-- Future main simulation information area -->
            <Grid Grid.Column="1"
          Margin="16">

                <TextBlock Text="Simulation"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="16"/>

            </Grid>
        </Grid>

        <!-- Resize handle for Bus Monitor -->
        <GridSplitter Grid.Row="2"
              Height="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{StaticResource BorderBrush}"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              Cursor="SizeNS"/>

        <!-- Bottom Monitor -->
        <Border Grid.Row="3"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,1,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="BUS MONITOR"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontWeight="Bold"
                   Margin="10,8"/>

                <DataGrid   x:Name="BusMonitorGrid"
                            Grid.Row="1"
                  ItemsSource="{Binding CanLog}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource BackgroundBrush}"
                  Foreground="{StaticResource TextBrush}"
                  BorderThickness="0"
                  RowBackground="{StaticResource BackgroundBrush}"
                  AlternatingRowBackground="{StaticResource PanelBrush}">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"
                                    Value="{StaticResource PanelAltBrush}"/>

                            <Setter Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>

                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderBrush}"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,1,1"/>

                            <Setter Property="Padding"
                                    Value="8,5"/>

                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background"
                                    Value="Transparent"/>

                            <Setter Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>

                            <Setter Property="BorderBrush"
                                    Value="{StaticResource BorderBrush}"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>

                            <Setter Property="Padding"
                                    Value="4,2"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Time"
                                    Binding="{Binding Time}"
                                    Width="90"/>

                        <DataGridTextColumn Header="Bus"
                                    Binding="{Binding Bus}"
                                    Width="90"/>

                        <DataGridTextColumn Header="Source"
                                    Binding="{Binding Source}"
                                    Width="90"/>

                        <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="80"/>

                        <DataGridTextColumn Header="DLC"
                                    Binding="{Binding Dlc}"
                                    Width="60"/>

                        <DataGridTextColumn Header="Data"
                                    Binding="{Binding Data}"
                                    Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Border>

    </Grid>

</Window>